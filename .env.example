# Supabase Data API connection
# Copy this file to .env.local and replace the placeholders.
# The publishable key is safe for browser use; access is still governed by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional canonical site URL; defaults to the existing Vercel production domain.
NEXT_PUBLIC_SITE_URL=https://software-discovery-engine.vercel.app
# Local development only. Ignored by production builds and servers.
# Generate .seed-output/product-preview.json before enabling.
PRODUCT_LOCAL_PREVIEW=false

# Analytics endpoints: leave disabled until collector, maintenance and producers pass QA.
# Server-only values. Never use NEXT_PUBLIC_ for these secrets or commit .env.local.
ANALYTICS_ENABLED=false
ANALYTICS_PRODUCER_ENABLED=false
ANALYTICS_MAINTENANCE_READY=false
ANALYTICS_PURGE_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=
# Independently generate 32 random bytes as 64 lowercase hex characters for each.
ANALYTICS_RATE_SECRET=
ANALYTICS_MAINTENANCE_SECRET=
