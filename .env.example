# Supabase Data API connection
# Copy this file to .env.local and replace the placeholders.
# The publishable key is safe for browser use; access is still governed by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Canonical production origin; also used by search and analytics origin validation.
NEXT_PUBLIC_SITE_URL=https://toolelse.com
# Local development only. Ignored by production builds and servers.
# Generate .seed-output/product-preview.json before enabling.
PRODUCT_LOCAL_PREVIEW=false

# Analytics endpoints: leave disabled until collector, maintenance and producers pass QA.
# Server-only values. Never use NEXT_PUBLIC_ for these secrets or commit .env.local.
ANALYTICS_ENABLED=false
ANALYTICS_PRODUCER_ENABLED=false
ANALYTICS_MAINTENANCE_READY=false
ANALYTICS_PURGE_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=
# Independently generate 32 random bytes as 64 lowercase hex characters for each.
ANALYTICS_RATE_SECRET=
ANALYTICS_MAINTENANCE_SECRET=


# Natural-language discovery. Keep disabled until server setup and owner QA.
# All four are server-only; never use NEXT_PUBLIC_ for model keys or secrets.
DISCOVERY_SEARCH_ENABLED=false
OPENAI_API_KEY=
OPENAI_DISCOVERY_MODEL=
# Independent random 32-byte value encoded as 64 lowercase hex characters.
DISCOVERY_SEARCH_RATE_SECRET=

# Analytics v2: leave disabled until migration and controlled acceptance.
ANALYTICS_V2_ENABLED=false
# Separate random 32-byte value as 64 lowercase hex characters; server-only.
ANALYTICS_CONTEXT_SECRET=

# Optional Vercel page views; production only, independent of Supabase analytics.
VERCEL_WEB_ANALYTICS_ENABLED=false
